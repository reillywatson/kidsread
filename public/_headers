# Vite's hashed bundles never change. Voice clips have a version in their URL (?v=…, changed
# whenever a clip is re-recorded), so they can be cached forever too. The service worker
# itself must always be re-checked, so new builds are picked up.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/voice/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
