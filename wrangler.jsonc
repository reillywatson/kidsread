{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site: Vite builds into dist/, served by Workers static assets (no server code).
  "name": "kidsread",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
