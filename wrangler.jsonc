{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The game is static (Vite builds into dist/, served by Workers static assets). A small Worker
  // (worker/index.ts) answers /api/* and /stats: backups and anonymous play stats, in D1.
  "name": "kidsread",
  "compatibility_date": "2026-10-15",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/stats"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kidsread",
      // From `npx wrangler d1 create kidsread`.
      "database_id": "04d05e05-f556-409b-bb2a-274ebca92c80",
      "migrations_dir": "migrations"
    }
  ]
}
